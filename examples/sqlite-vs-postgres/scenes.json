        {
          "id": "criteria-head",
          "type": "headline",
          "text": "Four questions decide it",
          "size": "lg",
          "align": "start",
          "layout": "heading"
        },
        {
          "id": "criteria",
          "type": "list",
          "style": "numbered",
          "items": [
            {
              "text": "How many machines talk to the database?"
            },
            {
              "text": "How many writes happen at the same instant?"
            },
            {
              "text": "How big will the data get?"
            },
            {
              "text": "Do you want to run a database server?"
            }
          ],
          "layout": {
            "col": 1,
            "row": 3,
            "colSpan": 9,
            "rowSpan": 5
          },
          "sourceRefs": [
            {
              "kind": "url",
              "url": "https://sqlite.org/whentouse.html#checklist_for_choosing_the_right_database_engine",
              "quote": "Many concurrent writers? \u2192 choose client/server"
