          "type": "list",
          "items": [
            {
              "text": "Readers and writers never block",
              "detail": "multiversion concurrency control",
              "mark": "check"
            },
            {
              "text": "No database size limit",
              "mark": "check"
            },
            {
              "text": "Extensible",
              "detail": "your own data types and functions",
              "mark": "check"
