    {
      "id": "contenders",
      "title": "The contenders",
      "kicker": "Options",
      "durationMs": 18000,
      "backdrop": "plain",
      "narration": "SQLite is a library inside your app: no server, unlimited readers, but one writer at a time. PostgreSQL is a server: readers and writers never block each other, and the database has no size limit, but it is one more thing to run.",
      "cues": [
        {
          "atMs": 0,
          "text": "SQLite: a library inside your app."
        },
        {
          "atMs": 8500,
          "text": "PostgreSQL: a server, built for concurrency."
        }
      ],
      "entities": [
        {
          "id": "sqlite-head",
          "type": "headline",
          "text": "SQLite",
          "size": "lg",
