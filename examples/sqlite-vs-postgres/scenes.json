          "type": "list",
          "items": [
            {
              "text": "No server to run",
              "detail": "built into the application, one file",
              "mark": "check"
            },
            {
              "text": "Unlimited readers",
              "mark": "check"
            },
            {
              "text": "Most websites fit",
              "detail": "under 100K hits a day, a conservative estimate",
              "mark": "check"
            },
            {
              "text": "One writer at a time",
              "mark": "cross"
            },
            {
              "text": "Not for many clients over a network",
              "mark": "cross"
            }
          ],
          "layout": {
            "col": 1,
