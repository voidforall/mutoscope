    {
      "id": "hardware",
      "title": "Fast without the convolution trick",
      "kicker": "The method",
      "durationMs": 18000,
      "backdrop": "plain",
      "narration": "Input-dependent parameters rule out the fast convolution that earlier models relied on. Mamba instead runs a scan that keeps the large expanded state in fast on-chip memory, never writing it out.",
      "cues": [
        {
          "atMs": 0,
          "text": "Input-dependent parameters rule out the fast convolution."
        },
        {
          "atMs": 5500,
          "text": "A scan keeps the expanded state in fast GPU memory."
        },
        {
          "atMs": 11000,
          "text": "Up to 3\u00d7 faster scans; 4\u20135\u00d7 the inference throughput."
        }
      ],
