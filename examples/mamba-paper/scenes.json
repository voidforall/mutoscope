    {
      "id": "idea",
      "title": "Selection",
      "kicker": "The idea",
      "durationMs": 18000,
      "backdrop": "grid",
      "narration": "The new idea is small. Let the model's parameters depend on the current token. Then each token decides what the fixed-size state should keep, and what it should forget.",
      "cues": [
        {
          "atMs": 0,
          "text": "Let the parameters depend on the current token."
        },
        {
          "atMs": 6000,
          "text": "Each token decides what the state keeps\u2026"
        },
        {
          "atMs": 11000,
          "text": "\u2026and what it forgets."
        }
      ],
      "entities": [
        {
          "id": "idea-head",
          "type": "headline",
          "text": "Make the parameters a function of the input",
          "size": "lg",
          "align": "start",
          "layout": "heading"
        },
        {
          "id": "token",
          "type": "component",
          "label": "Token",
          "sublabel": "x_t",
          "layout": {
            "col": 1,
            "row": 4,
            "colSpan": 2,
            "rowSpan": 2
          },
          "explanation": "The current input token."
        },
        {
          "id": "select",
          "type": "component",
          "label": "Selection",
          "sublabel": "\u0394, B, C = f(x_t)",
          "tone": "accent",
          "layout": {
            "col": 4,
            "row": 4,
            "colSpan": 3,
            "rowSpan": 2
          },
          "explanation": "The step size \u0394 and the projections B and C are computed from the token, instead of being fixed for all time steps.",
          "sourceRefs": [
            {
              "kind": "url",
              "url": "https://arxiv.org/html/2312.00752#abstract1.1",
              "quote": "simply letting the SSM parameters be functions of the input"
            }
          ]
        },
        {
          "id": "state",
          "type": "component",
          "label": "State h",
          "sublabel": "fixed size",
          "layout": {
            "col": 8,
            "row": 4,
            "colSpan": 2,
            "rowSpan": 2
          },
          "explanation": "A fixed-size recurrent state: cost per token does not grow with context length."
        },
        {
          "id": "output",
          "type": "component",
          "label": "Output",
          "sublabel": "y_t",
          "layout": {
            "col": 11,
            "row": 4,
            "colSpan": 2,
            "rowSpan": 2
          },
          "explanation": "The layer's output for this token, read from the state through C."
        },
        {
          "id": "e1",
          "type": "edge",
          "from": "token",
          "to": "select"
        },
        {
          "id": "e2",
          "type": "edge",
          "from": "select",
          "to": "state",
          "label": "keeps"
        },
        {
          "id": "e3",
          "type": "edge",
          "from": "state",
          "to": "output"
        },
        {
          "id": "idea-note",
          "type": "label",
          "text": "Filter out what is irrelevant, remember what matters indefinitely.",
          "size": "md",
          "align": "center",
          "tone": "accent",
          "layout": {
            "col": 2,
            "row": 7,
            "colSpan": 10,
            "rowSpan": 1
          },
          "sourceRefs": [
            {
              "kind": "url",
              "url": "https://arxiv.org/html/2312.00752#S1.SS0.SSS0.Px1.p1.1",
              "quote": "This allows the model to filter out irrelevant information and remember relevant information indefinitely."
            }
          ]
        }
      ],
