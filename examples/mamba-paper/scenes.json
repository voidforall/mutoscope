    {
      "id": "problem",
      "title": "Quadratic attention, weak alternatives",
      "kicker": "The problem",
      "durationMs": 16000,
      "narration": "Attention compares every token with every other, so its cost grows with the square of the context. State space models run in linear time, but until now they have been weak on text.",
      "cues": [
        {
          "atMs": 0,
          "text": "Attention compares every token with every other one."
        },
        {
          "atMs": 5000,
          "text": "State space models run in linear time\u2026"
        },
        {
          "atMs": 9000,
          "text": "\u2026but they have been weak on text."
        }
      ],
      "entities": [
