    {
      "id": "pitfalls",
      "title": "When it goes wrong",
      "kicker": "Pitfalls",
      "durationMs": 15000,
      "backdrop": "plain",
      "narration": "Three mistakes to avoid. Don't edit the lockfile by hand. Do commit it. And if you run a script without uv run, activate the environment first.",
      "entities": [
        {
          "id": "pitfalls-head",
          "type": "headline",
          "text": "Three mistakes to avoid",
          "size": "lg",
          "align": "start",
          "layout": "heading"
        },
        {
          "id": "pitfalls",
          "type": "list",
          "items": [
            {
              "text": "Editing uv.lock by hand",
              "detail": "it is managed by uv: change pyproject.toml or use uv add and uv remove",
              "mark": "cross"
            },
            {
              "text": "Leaving uv.lock out of git",
              "detail": "commit it, so every machine installs the same versions",
              "mark": "cross"
            },
            {
              "text": "python script.py, outside uv run",
              "detail": "activate .venv first, or just use uv run",
              "mark": "cross"
            }
          ],
          "layout": {
            "col": 1,
            "row": 3,
            "colSpan": 10,
            "rowSpan": 5
          },
          "sourceRefs": [
            {
              "kind": "url",
              "url": "https://docs.astral.sh/uv/guides/projects/#uvlock",
              "quote": "should not be edited manually"
            },
            {
              "kind": "url",
              "url": "https://docs.astral.sh/uv/guides/projects/#uvlock",
              "quote": "This file should be checked into version control"
            },
            {
              "kind": "url",
              "url": "https://docs.astral.sh/uv/guides/projects/#running-commands",
              "quote": "The virtual environment must be active to run scripts and commands in the project without uv run."
            }
          ]
        }
      ],
      "timeline": [
        {
          "action": "appear",
          "atMs": 300,
          "target": "pitfalls",
          "durationMs": 9000
        }
      ],
      "claims": [
