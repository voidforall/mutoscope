{
  "name": "mutoscope",
  "version": "0.1.0",
  "description": "Turn code changes, systems and ideas into interactive, discussable animated reels. A model-agnostic agent skill + CLI, portable reel format and static player.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "mutoscope": "skills/mutoscope/runtime/cli.mjs"
  },
  "scripts": {
    "build": "npm run build:player && npm run build:cli",
    "build:player": "vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "install-skill": "npm run build && node scripts/install-skill.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
